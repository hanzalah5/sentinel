# --- Runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# Set to false for pretty console logs in local dev, true for JSON logs in prod.
JSON_LOGS=false

# --- LLM (Google Gemini) ---
# Required for /investigate to work. Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Langfuse (optional; tracing degrades gracefully if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region your Langfuse project lives in:
#   EU region -> https://cloud.langfuse.com
#   US region -> https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Runbook RAG (Postgres + pgvector) ---
# Leave DATABASE_URL blank to disable retrieval (the agent still runs, ungrounded).
DATABASE_URL=
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768
RUNBOOK_TOP_K=3

# --- Human-in-the-loop remediation ---
# "none" => every proposed remediation needs human approval (safest default).
# Set to low/medium/high to auto-approve actions up to that risk level.
HITL_AUTO_APPROVE_MAX_RISK=none

# --- Ingestion (Redis Streams) ---
REDIS_URL=redis://localhost:6379/0
ALERT_STREAM=sentinel:alerts
CONSUMER_GROUP=sentinel-workers
CONSUMER_NAME=worker-1
DEAD_LETTER_STREAM=sentinel:alerts:dlq
MAX_DELIVERY_ATTEMPTS=3
